#include <winver.h>

1 24 "installer.manifest"

#include "probes.rc"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "EXCCD"
      VALUE "FileDescription", "EXCCD SD card installer"
      VALUE "FileVersion", "1.0"
      VALUE "InternalName", "exccd-installer"
      VALUE "LegalCopyright", "GPL v2"
      VALUE "OriginalFilename", "exccd-installer.exe"
      VALUE "ProductName", "EXCCD"
      VALUE "ProductVersion", "1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
